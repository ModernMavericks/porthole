# GENERATED by bin/generate-viewer from apps/clion.conf + templates/ -- DO NOT EDIT.
FROM debian:13-slim

# Common viewer runtime (xpra + its deps, dbus, keyring, notifications, lz4, socat)
# plus Linux CLion's own package(s). Generated container: only the bridges Linux CLion needs are
# pulled in (audio/printing/etc. are opt-in per the manifest); no legacy VNC stack.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
      dbus dbus-x11 util-linux \
      python3-dbus python3-lz4 \
      gnome-keyring libsecret-1-0 socat fontconfig libfreetype6 libxext6 libxi6 libxrender1 libxtst6 libxrandr2 procps \
    # xpra (the display server for the Porthole client) is not in Debian; pull from
    # xpra.org and PIN it: the Porthole native client is written against a specific
    # xpra wire protocol, so an unpinned install could drift to an incompatible xpra
    # on rebuild. xpra.org's trixie repo retains old versions, so this pin is stable.
    # Bump it only together with the viewer (see op's PORTHOLE_XPRA_VERSION compat check).
    && curl -sS https://xpra.org/xpra.asc -o /usr/share/keyrings/xpra.asc \
    && echo 'deb [signed-by=/usr/share/keyrings/xpra.asc] https://xpra.org/ trixie main' \
       > /etc/apt/sources.list.d/xpra.list \
    && apt-get update \
    && apt-get install -y  xpra=6.5.2-r0-1 xvfb \
    && rm -rf /var/lib/apt/lists/*

# Not apt-packaged (e.g. a JetBrains IDE): fetch the upstream tarball, extract to
# /opt/clion (--strip-components=1 drops the versioned top dir so the path is stable),
# and symlink its launcher onto PATH. TARBALL_URL may be a "latest" redirect.
RUN mkdir -p /opt/clion \
    && curl -fSL 'https://download.jetbrains.com/product?code=CL&latest&distribution=linux' | tar -xz -C /opt/clion --strip-components=1 \
    && ln -sf /opt/clion/bin/clion.sh /usr/local/bin/clion

# The app refuses to run as root; give it a real user (Electron apps and 1Password
# alike). USER_GROUP pins an existing group the app's own package created.
RUN useradd -m -u 1000 clion

COPY start-clion-gui.sh clion-child.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/start-clion-gui.sh /usr/local/bin/clion-child.sh
# Map Mac/CSS system font names to Helvetica Neue (alias only, no font data).
COPY mac-fonts.conf /etc/fonts/conf.d/09-mac-fonts.conf

ENTRYPOINT ["/usr/local/bin/start-clion-gui.sh"]
