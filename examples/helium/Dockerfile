# GENERATED by bin/generate-viewer from apps/helium.conf + templates/ -- DO NOT EDIT.
FROM ghcr.io/modernmavericks/porthole-base:latest

# Linux Helium's own package(s), from the vendor's apt repo -- installed here on YOUR Mac, so Porthole
# never redistributes vendor software. The common runtime (xpra + Xvfb, dbus, keyring, socat, the
# menu daemon, the Mac-font alias) is already in the pre-built shared base ghcr.io/modernmavericks/porthole-base:latest.
RUN curl -sS https://raw.githubusercontent.com/imputnet/helium-linux/main/pubkey.asc \
       | gpg --dearmor -o /usr/share/keyrings/helium-desktop-keyring.gpg \
    && echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/helium-desktop-keyring.gpg] https://pkg.helium.computer/deb stable main' \
       > /etc/apt/sources.list.d/helium.list
RUN apt-get update \
    && apt-get install -y --no-install-recommends helium-bin pulseaudio \
    && rm -rf /var/lib/apt/lists/*

# The app refuses to run as root; give it a real user (Electron apps and 1Password
# alike). USER_GROUP pins an existing group the app's own package created.
RUN useradd -m -u 1000 helium

COPY start-helium-gui.sh helium-child.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/start-helium-gui.sh /usr/local/bin/helium-child.sh
ENTRYPOINT ["/usr/local/bin/start-helium-gui.sh"]
