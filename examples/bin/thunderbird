#!/bin/sh
# GENERATED by bin/generate-viewer from apps/thunderbird.conf + templates/ -- DO NOT EDIT.
# Launch the Linux Thunderbird app-specific viewer: ensure the thunderbird-gui container is up,
# tunnel to its xpra port, and open the native Porthole "Linux Thunderbird" client. Minimal by
# design -- Signal has no account/CLI (contrast bin/op). Env overrides in caps.
set -eu
IMAGE="${THUNDERBIRD_IMAGE:-mavericks-thunderbird}"
CONTAINER="${THUNDERBIRD_CONTAINER:-thunderbird-gui}"
VOLUME="${THUNDERBIRD_VOLUME:-thunderbird-gui-data}"
PORT="${THUNDERBIRD_XPRA_PORT:-10002}"
MACHINE="${THUNDERBIRD_MACHINE:-default}"
TUNNEL_PID="${TMPDIR:-/tmp}/thunderbird-xpra-tunnel.$PORT.pid"
# Mac-side end of the xpra Unix-socket bridge (the client connects here).
XPRA_SOCK="${TMPDIR:-/tmp}/thunderbird-xpra.sock"
CONFIG_DIR="${THUNDERBIRD_CONFIG_DIR:-$HOME/.config/porthole/thunderbird}"
REBUILD=0
[ "${1:-}" = --rebuild ] && REBUILD=1
PORTHOLE_XPRA_VERSION="${THUNDERBIRD_XPRA_VERSION:-6.5}"   # major.minor the viewer speaks

_root=$(cd "$(dirname "$0")/.." && pwd)   # Contents/Resources of the materialized app

die() { echo "thunderbird: $*" >&2; exit 1; }

# First-launch feedback: the launcher is a windowless foreground app during container setup, so post
# Mac notifications (best-effort -- osascript may be absent/denied). $1 = message; title is the app.
notify() { osascript -e "display notification \"$1\" with title \"Linux Thunderbird\"" >/dev/null 2>&1 || true; }

# Host prerequisites (Container Tools -> Fusion). Reuse Container Tools' own contract
# `docker-machine-ctl status` (one word) for actionable errors instead of cryptic docker
# failures. Bypassed on an explicit endpoint or THUNDERBIRD_NO_PREFLIGHT=1.
preflight_host() {
  [ "${THUNDERBIRD_NO_PREFLIGHT:-}" = 1 ] && return 0
  [ -n "${DOCKER_HOST:-}" ] && return 0
  [ -n "${DOCKER_CONTEXT:-}" ] && return 0
  command -v docker-machine-ctl >/dev/null 2>&1 \
    || die "Mavericks Container Tools not found -- install it (it provides the Docker VM this app runs in): https://github.com/ModernMavericks/container-tools"
  _w=$(docker-machine-ctl status 2>/dev/null)
  case $_w in
    running) return 0 ;;
    no-fusion) die "VMware Fusion is required -- Container Tools can't run the Docker VM without it; install or open VMware Fusion" ;;
    absent) die "the Docker VM isn't set up yet -- run: docker-machine-ctl setup" ;;
    stopped) die "the Docker VM is stopped -- start it: docker-machine-ctl start" ;;
    creating) die "Container Tools is creating the Docker VM -- try again in a moment" ;;
    working:*) die "Container Tools is busy (${_w#working:}) -- try again in a moment" ;;
    *) die "Container Tools reports a problem -- check: docker-machine-ctl status" ;;
  esac
}
preflight_host

nudge_once() {   # $1 = key, $2 = message; advisory, once per day
  mkdir -p "$CONFIG_DIR" 2>/dev/null || return 0
  _stamp="$CONFIG_DIR/nudged-$1"; _today=$(date '+%Y-%m-%d')
  [ "$(cat "$_stamp" 2>/dev/null)" = "$_today" ] && return 0
  printf '%s\n' "$_today" > "$_stamp" 2>/dev/null || true
  echo "thunderbird: $2" >&2
}
check_container_staleness() {
  _days=${THUNDERBIRD_STALE_DAYS:-30}
  _created=$(docker image inspect -f '{{.Created}}' "$IMAGE" 2>/dev/null) || return 0
  [ -n "$_created" ] || return 0
  _created=${_created%%.*}; _created=${_created%Z}
  _cepoch=$(date -ju -f '%Y-%m-%dT%H:%M:%S' "$_created" '+%s' 2>/dev/null) || return 0
  _age=$(( ($(date -u '+%s') - _cepoch) / 86400 ))
  [ "$_age" -gt "$_days" ] || return 0
  nudge_once staleness "your $IMAGE container is ${_age} days old; rebuild to pick up updates: $0 --rebuild"
}
check_xpra_compat() {
  _raw=$(docker exec "$CONTAINER" xpra --version 2>/dev/null) || return 0
  _ver=${_raw##* }; _ver=${_ver#v}
  case $_ver in [0-9]*.[0-9]*) ;; *) return 0 ;; esac
  _mm=$(printf '%s' "$_ver" | cut -d. -f1,2)
  [ "$_mm" = "$PORTHOLE_XPRA_VERSION" ] && return 0
  nudge_once xpra-compat "this container's xpra ($_mm) differs from what the viewer expects ($PORTHOLE_XPRA_VERSION); rebuild recommended: $0 --rebuild"
}

eval "$(docker-machine env "$MACHINE" 2>/dev/null)" || true

if [ "$REBUILD" = 1 ]; then
  docker build --no-cache --pull -t "$IMAGE" "$_root/thunderbird" || die "image build failed"
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
fi

# Ensure the container exists and is running (build the image on first use).
if ! docker container inspect "$CONTAINER" >/dev/null 2>&1; then
  docker image inspect "$IMAGE" >/dev/null 2>&1 || {
    # First run builds the Linux container (minutes). The launcher has no window yet, so surface
    # progress as Mac notifications -- one per Dockerfile step -- else the app looks dead while it works.
    echo "thunderbird: building $IMAGE (first run)..."
    notify "First run: building the Linux container. This runs once and can take a few minutes…"
    docker build -t "$IMAGE" "$_root/thunderbird" 2>&1 | while IFS= read -r _bl; do
      case "$_bl" in "Step "*) notify "Setting up… ${_bl%% : *}" ;; esac   # e.g. "Setting up… Step 4/7"
      printf '%s\n' "$_bl"
    done
    # The pipe hides docker's exit status (POSIX sh has no PIPESTATUS); the image's existence is truth.
    docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image build failed"
    notify "Container ready — starting Linux Thunderbird…"
  }
  docker volume create "$VOLUME" >/dev/null || die "cannot create volume $VOLUME"
  # Host-FS mounts: app-inherent ( from the manifest) + ad-hoc
  # (THUNDERBIRD_MOUNTS env, for your own paths -- e.g. an IDE project). Each spec is
  #   MACPATH[:CONTAINERPATH][:ro]   -- MACPATH may use $HOME (your Mac home);
  # CONTAINERPATH defaults to MACPATH (path-matched, so paths line up with the Mac).
  # Only /Users is shared by the VM. (Applied at create; recreate to change.)
  MOUNT_ARGS=""
  for _m in  ${THUNDERBIRD_MOUNTS:-}; do
    case "$_m" in *:ro) _ro=":ro"; _m="${_m%:ro}" ;; *) _ro="" ;; esac
    case "$_m" in *:*) _mac="${_m%%:*}"; _ctr="${_m#*:}" ;; *) _mac="$_m"; _ctr="$_m" ;; esac
    [ -e "$_mac" ] || { echo "thunderbird: skipping mount, no such path: $_mac" >&2; continue; }
    MOUNT_ARGS="$MOUNT_ARGS -v $_mac:$_ctr$_ro"
  done
  # shellcheck disable=SC2086  # word-splitting is intentional (one -v per mount)
  docker run -d --name "$CONTAINER" --hostname mavericks-thunderbird \
    --restart unless-stopped --init --shm-size 512m \
    --security-opt seccomp=unconfined \
    -v "$VOLUME:/home/thunderbird/.thunderbird" $MOUNT_ARGS \
    "$IMAGE" >/dev/null || die "cannot create container $CONTAINER"
else
  docker container inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true \
    || docker start "$CONTAINER" >/dev/null || die "cannot start $CONTAINER"
fi

check_container_staleness
check_xpra_compat

# Wait until xpra is actually ACCEPTING CONNECTIONS on its Unix socket inside the
# container -- not merely that the process exists. On a cold start the socket is bound a
# beat after the process appears; opening the viewer in that gap makes it hit "connection
# refused" and show no window (and can leave the app's focus handshake stuck). Gate on a
# real AF_UNIX connect (python3 is always present -- xpra needs it).
_i=0
while [ "$_i" -lt 150 ] && ! docker exec "$CONTAINER" \
    python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); s.settimeout(1); sys.exit(s.connect_ex("/run/user/1000/porthole-xpra.sock"))' 2>/dev/null; do
  sleep 0.2; _i=$((_i + 1))
done

# Local bridge to the container's xpra Unix socket (socat over `docker exec -i`), Unix on
# BOTH ends -- no TCP port to allocate, nothing network-exposed. The container-side socat
# runs as root and connects the app user's socket by path.
if ! { [ -f "$TUNNEL_PID" ] && ps -p "$(cat "$TUNNEL_PID")" >/dev/null 2>&1; }; then
  command -v socat >/dev/null 2>&1 || die "socat not found on the Mac (e.g. pkgin install socat)"
  rm -f "$XPRA_SOCK"
  _exec="EXEC:docker exec -i $CONTAINER socat STDIO UNIX-CONNECT\\:/run/user/1000/porthole-xpra.sock"
  socat "UNIX-LISTEN:$XPRA_SOCK,fork,reuseaddr" "$_exec" &
  echo $! > "$TUNNEL_PID"
fi

# Second bridge: the live-menu channel. A Unix-domain socket, forwarded the same way as
# the xpra port (socat over `docker exec -i`), Unix on BOTH ends -- no TCP port to
# allocate and nothing network-exposed. The container-side menu daemon (a later
# sub-project) listens on /run/user/1000/porthole-menu.sock; here we only stand up the bridge. The
# Mac end MUST match what the viewer dials: $TMPDIR/thunderbird-menu.sock (== appDisplayName
# lowercased). Its own pidfile so it tears down independently of the xpra tunnel.
MENU_SOCK="${TMPDIR:-/tmp}/thunderbird-menu.sock"
MENU_TUNNEL_PID="${TMPDIR:-/tmp}/thunderbird-menu-sock.$PORT.pid"
if ! { [ -f "$MENU_TUNNEL_PID" ] && ps -p "$(cat "$MENU_TUNNEL_PID")" >/dev/null 2>&1; }; then
  rm -f "$MENU_SOCK"
  _mexec="EXEC:docker exec -i $CONTAINER socat STDIO UNIX-CONNECT\\:/run/user/1000/porthole-menu.sock"
  socat "UNIX-LISTEN:$MENU_SOCK,fork,reuseaddr" "$_mexec" &
  echo $! > "$MENU_TUNNEL_PID"
fi

# One-time: replace the penguin DEFAULT icon with Linux Thunderbird's REAL icon, extracted from the container
# (the user's OWN installed copy -- Porthole never ships a vendor icon). Runs once (marker guard),
# best-effort. The running viewer already has the penguin; the real icon shows from the NEXT launch
# (LaunchServices re-reads the bundle -- `touch`ed here -- so no mid-session Dock hackery needed).
_iconmark="$CONFIG_DIR/icon-done"
if [ ! -f "$_iconmark" ] && [ -n "/usr/share/icons/hicolor/256x256/apps/thunderbird.png" ] && [ -x "$_root/bin/extract-app-icns.sh" ]; then
  if ONEP_CONTAINER="$CONTAINER" PORTHOLE_ICON_GLOB="/usr/share/icons/hicolor/256x256/apps/thunderbird.png" \
       sh "$_root/bin/extract-app-icns.sh" "$_root/AppIcon.icns.new" >/dev/null 2>&1; then
    mv -f "$_root/AppIcon.icns.new" "$_root/AppIcon.icns"
    touch "$(cd "$_root/../.." && pwd)" 2>/dev/null || true   # nudge LaunchServices to re-read the icon
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true; : > "$_iconmark" 2>/dev/null || true
    echo "thunderbird: installed Linux Thunderbird's real icon (from your container); it shows next launch" >&2
  fi
fi

# This viewer runs its OWN copy of the Porthole engine binary, IN PLACE (exec, not `open` of a shared
# app) -- so the running process IS this bundle: its own icon, name, and LaunchServices instance. That
# is what lets several materialized viewers (Signal, 1Password, ...) run at once, each as itself,
# instead of all reactivating one shared Porthole.app. The engine CODE is shared (materialize copied it
# from the installed Porthole.app); the IDENTITY is this bundle's. $_root is Contents/Resources.
_bin="${THUNDERBIRD_VIEWER_BIN:-$_root/../MacOS/Porthole}"   # override for dev/test
_appbundle="$(cd "$_root/../.." && pwd)"
[ -x "$_bin" ] || die "the Linux Thunderbird viewer binary is missing -- reinstall Porthole + this app, or re-run: porthole materialize"

# Auto-recovery: a detached watcher relaunches the viewer if it dies from a lost backend (VM reboot /
# container restart / tunnel drop) and -- for on-demand containers -- stops the container on a real
# Quit. It relaunches via `open` on THIS .app, so the recovered viewer keeps this bundle's identity.
# Spawned BEFORE the exec below (exec replaces this process). Guarded so recovery doesn't stack watchers.
MARKER="${XPRA_SOCK%-xpra.sock}-viewer-lost"
WATCH_PID="${TMPDIR:-/tmp}/thunderbird-watch.$PORT.pid"
RW_ONDEMAND=""
RW_ONDEMAND=1
if [ -x "$_root/bin/porthole-recover-watch" ] && [ -z "${THUNDERBIRD_NO_RECOVER:-}" ] \
   && ! { [ -f "$WATCH_PID" ] && ps -p "$(cat "$WATCH_PID")" >/dev/null 2>&1; }; then
  RW_BIN="$_bin" RW_MARKER="$MARKER" RW_RELAUNCH="open \"$_appbundle\"" RW_PIDFILE="$WATCH_PID" \
  RW_ONDEMAND="$RW_ONDEMAND" RW_CONTAINER="$CONTAINER" \
  RW_STOP_PIDS="$TUNNEL_PID $MENU_TUNNEL_PID" \
  nohup "$_root/bin/porthole-recover-watch" </dev/null >/dev/null 2>&1 3>&- &
fi

echo "Linux Thunderbird viewer: launching -> $XPRA_SOCK (container stops when you Quit the viewer)"
exec "$_bin" "$XPRA_SOCK"
